{
  "$schema": "Color tokens — taxonomía de 7 grupos (brand, surface, text, state, map, poi, shadow). Cada token semántico apunta a un primitivo vía $ref y emite uno o varios CSS vars en `_css` (array). Esto permite que un único token semántico alimente a la vez su nombre canónico (--brand-primary) y los nombres legacy de shadcn (--primary, --ring) sin necesidad de renombrar componentes. Los tokens de map.* y poi.* viven en map.json/poi.json; aquí solo se exponen alias para que aparezcan agrupados en el panel de color.",
  "color": {
    "primitives": {
      "light": {
        "neutral": {
          "0":   { "value": "0 0% 100%"  },
          "50":  { "value": "40 20% 98%" },
          "100": { "value": "40 15% 93%" },
          "200": { "value": "40 15% 88%" },
          "500": { "value": "220 10% 46%" },
          "900": { "value": "220 20% 14%" }
        },
        "brand": {
          "50":  { "value": "24 60% 94%" },
          "500": { "value": "24 75% 50%" },
          "700": { "value": "24 75% 35%" }
        },
        "info": {
          "500": { "value": "200 65% 48%" }
        },
        "success": {
          "500": { "value": "142 71% 45%" }
        },
        "warning": {
          "500": { "value": "45 93% 47%" }
        },
        "danger": {
          "500": { "value": "0 72% 55%" }
        },
        "poi": {
          "mine":     { "value": "0 0% 100%"    },
          "followed": { "value": "45 93% 81%"   },
          "service":  { "value": "199 95% 86%"  },
          "enriched": { "value": "142 71% 45%"  },
          "empty":    { "value": "24 95% 53%"   },
          "error":    { "value": "0 72% 51%"    }
        }
      },
      "dark": {
        "neutral": {
          "0":   { "value": "0 0% 100%"   },
          "100": { "value": "40 15% 94%"  },
          "500": { "value": "40 10% 58%"  },
          "700": { "value": "220 18% 18%" },
          "800": { "value": "220 18% 16%" },
          "900": { "value": "220 18% 13%" },
          "950": { "value": "220 20% 8%"  }
        },
        "brand": {
          "300": { "value": "24 70% 70%" },
          "500": { "value": "24 80% 55%" },
          "900": { "value": "24 40% 18%" }
        },
        "info": {
          "500": { "value": "200 60% 52%" }
        },
        "success": {
          "500": { "value": "142 65% 55%" }
        },
        "warning": {
          "500": { "value": "45 90% 60%" }
        },
        "danger": {
          "500": { "value": "0 65% 48%" }
        },
        "poi": {
          "mine":     { "value": "0 0% 92%"    },
          "followed": { "value": "45 70% 65%"  },
          "service":  { "value": "199 70% 65%" },
          "enriched": { "value": "142 60% 55%" },
          "empty":    { "value": "24 80% 60%"  },
          "error":    { "value": "0 65% 58%"   }
        }
      }
    },

    "light": {
      "brand": {
        "primary":          { "$ref": "color.primitives.light.brand.500",  "_css": ["--brand-primary", "--primary", "--ring"] },
        "accent":           { "$ref": "color.primitives.light.brand.50",   "_css": ["--brand-accent", "--accent"] },
        "accentForeground": { "$ref": "color.primitives.light.brand.700",  "_css": ["--brand-accent-foreground", "--accent-foreground"] }
      },
      "surface": {
        "background": { "$ref": "color.primitives.light.neutral.50",  "_css": ["--surface-bg", "--background"] },
        "card":       { "$ref": "color.primitives.light.neutral.0",   "_css": ["--surface-card", "--card"] },
        "popup":      { "$ref": "color.primitives.light.neutral.0",   "_css": ["--surface-popup", "--popover"] },
        "muted":      { "$ref": "color.primitives.light.neutral.100", "_css": ["--surface-muted", "--muted"] },
        "overlay":    { "$ref": "color.primitives.light.neutral.900", "_css": ["--surface-overlay"] },
        "border":     { "$ref": "color.primitives.light.neutral.200", "_css": ["--surface-border", "--border", "--input"] }
      },
      "text": {
        "primary":   { "$ref": "color.primitives.light.neutral.900", "_css": ["--text-primary", "--foreground", "--card-foreground", "--popover-foreground"] },
        "secondary": { "$ref": "color.primitives.light.neutral.500", "_css": ["--text-secondary", "--muted-foreground"] },
        "inverse":   { "$ref": "color.primitives.light.neutral.0",   "_css": ["--text-inverse", "--primary-foreground", "--secondary-foreground", "--destructive-foreground"] }
      },
      "state": {
        "success": { "$ref": "color.primitives.light.success.500", "_css": ["--state-success"] },
        "warning": { "$ref": "color.primitives.light.warning.500", "_css": ["--state-warning"] },
        "error":   { "$ref": "color.primitives.light.danger.500",  "_css": ["--state-error", "--destructive"] },
        "loading": { "$ref": "color.primitives.light.info.500",    "_css": ["--state-loading", "--secondary"] }
      },
      "map": {
        "background": { "$ref": "map.canvas.tileA",            "_css": ["--color-map-bg"] },
        "route":      { "$ref": "color.primitives.light.brand.500", "_css": ["--color-map-route"] },
        "selected":   { "$ref": "color.primitives.light.brand.500", "_css": ["--color-map-selected"] }
      },
      "poi": {
        "mine":     { "$ref": "color.primitives.light.poi.mine",     "_css": ["--color-poi-mine"] },
        "followed": { "$ref": "color.primitives.light.poi.followed", "_css": ["--color-poi-followed"] },
        "service":  { "$ref": "color.primitives.light.poi.service",  "_css": ["--color-poi-service"] },
        "enriched": { "$ref": "color.primitives.light.poi.enriched", "_css": ["--color-poi-enriched"] },
        "empty":    { "$ref": "color.primitives.light.poi.empty",    "_css": ["--color-poi-empty"] },
        "error":    { "$ref": "color.primitives.light.poi.error",    "_css": ["--color-poi-error"] }
      },
      "shadow": {
        "sm": { "value": "0 1px 2px 0 hsl(0 0% 0% / 0.08)",    "_css": ["--shadow-sm"] },
        "md": { "value": "0 4px 12px -2px hsl(0 0% 0% / 0.12)", "_css": ["--shadow-md"] },
        "lg": { "value": "0 16px 32px -8px hsl(0 0% 0% / 0.18)", "_css": ["--shadow-lg"] }
      }
    },

    "dark": {
      "brand": {
        "primary":          { "$ref": "color.primitives.dark.brand.500", "_css": ["--brand-primary", "--primary", "--ring"] },
        "accent":           { "$ref": "color.primitives.dark.brand.900", "_css": ["--brand-accent", "--accent"] },
        "accentForeground": { "$ref": "color.primitives.dark.brand.300", "_css": ["--brand-accent-foreground", "--accent-foreground"] }
      },
      "surface": {
        "background": { "$ref": "color.primitives.dark.neutral.950", "_css": ["--surface-bg", "--background"] },
        "card":       { "$ref": "color.primitives.dark.neutral.900", "_css": ["--surface-card", "--card"] },
        "popup":      { "$ref": "color.primitives.dark.neutral.900", "_css": ["--surface-popup", "--popover"] },
        "muted":      { "$ref": "color.primitives.dark.neutral.800", "_css": ["--surface-muted", "--muted"] },
        "overlay":    { "$ref": "color.primitives.dark.neutral.950", "_css": ["--surface-overlay"] },
        "border":     { "$ref": "color.primitives.dark.neutral.700", "_css": ["--surface-border", "--border", "--input"] }
      },
      "text": {
        "primary":   { "$ref": "color.primitives.dark.neutral.100", "_css": ["--text-primary", "--foreground", "--card-foreground", "--popover-foreground"] },
        "secondary": { "$ref": "color.primitives.dark.neutral.500", "_css": ["--text-secondary", "--muted-foreground"] },
        "inverse":   { "$ref": "color.primitives.dark.neutral.0",   "_css": ["--text-inverse", "--primary-foreground", "--secondary-foreground", "--destructive-foreground"] }
      },
      "state": {
        "success": { "$ref": "color.primitives.dark.success.500", "_css": ["--state-success"] },
        "warning": { "$ref": "color.primitives.dark.warning.500", "_css": ["--state-warning"] },
        "error":   { "$ref": "color.primitives.dark.danger.500",  "_css": ["--state-error", "--destructive"] },
        "loading": { "$ref": "color.primitives.dark.info.500",    "_css": ["--state-loading", "--secondary"] }
      },
      "map": {
        "background": { "$ref": "map.canvas.tileA",           "_css": ["--color-map-bg"] },
        "route":      { "$ref": "color.primitives.dark.brand.500", "_css": ["--color-map-route"] },
        "selected":   { "$ref": "color.primitives.dark.brand.500", "_css": ["--color-map-selected"] }
      },
      "poi": {
        "mine":     { "$ref": "color.primitives.dark.poi.mine",     "_css": ["--color-poi-mine"] },
        "followed": { "$ref": "color.primitives.dark.poi.followed", "_css": ["--color-poi-followed"] },
        "service":  { "$ref": "color.primitives.dark.poi.service",  "_css": ["--color-poi-service"] },
        "enriched": { "$ref": "color.primitives.dark.poi.enriched", "_css": ["--color-poi-enriched"] },
        "empty":    { "$ref": "color.primitives.dark.poi.empty",    "_css": ["--color-poi-empty"] },
        "error":    { "$ref": "color.primitives.dark.poi.error",    "_css": ["--color-poi-error"] }
      },
      "shadow": {
        "sm": { "value": "0 1px 2px 0 hsl(0 0% 0% / 0.4)",    "_css": ["--shadow-sm"] },
        "md": { "value": "0 4px 12px -2px hsl(0 0% 0% / 0.5)", "_css": ["--shadow-md"] },
        "lg": { "value": "0 16px 32px -8px hsl(0 0% 0% / 0.6)", "_css": ["--shadow-lg"] }
      }
    }
  }
}
