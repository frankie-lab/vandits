{
  "$schema": "Map tokens — zoom render-mode thresholds and Leaflet pane z-indices. Single source consumed by src/design-system/map/rules/* and adapters. NEVER hardcode these values inside rules/ or icons/.",
  "map": {
    "zoom": {
      "microMax":    { "value": 9,  "_css": "--map-zoom-micro-max" },
      "compactMax":  { "value": 13, "_css": "--map-zoom-compact-max" },
      "standardMax": { "value": 16, "_css": "--map-zoom-standard-max" },
      "heroMin":     { "value": 14, "_css": "--map-zoom-hero-min" },
      "richMin":     { "value": 17, "_css": "--map-zoom-rich-min" }
    },
    "pane": {
      "tile":          { "value": 200, "_css": "--map-pane-tile" },
      "overlay":       { "value": 400, "_css": "--map-pane-overlay" },
      "marker":        { "value": 600, "_css": "--map-pane-marker" },
      "markerFocused": { "value": 650, "_css": "--map-pane-marker-focused" },
      "tooltip":       { "value": 700, "_css": "--map-pane-tooltip" },
      "popup":         { "value": 800, "_css": "--map-pane-popup" }
    }
  }
}
