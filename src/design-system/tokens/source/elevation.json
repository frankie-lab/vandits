{
  "$schema": "Elevation tokens — shadows + blur for floating surfaces (popups, focused markers, overlays). Single source for both UI primitives and map adapters.",
  "elevation": {
    "shadow": {
      "sm":     { "value": "0 1px 2px 0 hsl(0 0% 0% / 0.05)",                                       "_css": "--shadow-sm" },
      "md":     { "value": "0 4px 6px -1px hsl(0 0% 0% / 0.1), 0 2px 4px -2px hsl(0 0% 0% / 0.1)",   "_css": "--shadow-md" },
      "lg":     { "value": "0 10px 15px -3px hsl(0 0% 0% / 0.1), 0 4px 6px -4px hsl(0 0% 0% / 0.1)", "_css": "--shadow-lg" },
      "xl":     { "value": "0 20px 25px -5px hsl(0 0% 0% / 0.15), 0 8px 10px -6px hsl(0 0% 0% / 0.1)", "_css": "--shadow-xl" },
      "marker": { "value": "0 2px 4px hsl(0 0% 0% / 0.25)",                                          "_css": "--shadow-marker" },
      "popup":  { "value": "0 12px 32px -8px hsl(0 0% 0% / 0.25)",                                   "_css": "--shadow-popup" }
    },
    "blur": {
      "sm": { "value": "4px",  "_css": "--blur-sm" },
      "md": { "value": "8px",  "_css": "--blur-md" },
      "lg": { "value": "16px", "_css": "--blur-lg" }
    }
  }
}
